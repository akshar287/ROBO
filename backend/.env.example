# ROBO AI Assistant - Backend Configuration

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security & JWT (Generate a secure secret using: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-super-secret-hex-key-minimum-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default for zero-setup local MVP, or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./robo.db

# AI Provider Settings (Ollama local is default free choice, or compatible API)
# Options: "ollama", "openai_compatible", "mock"
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Optional Cloud AI Fallback / Alternative (e.g., Groq, Gemini OpenAI-compatible)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_MODEL=llama-3.1-8b-instant

# Multilingual Speech Recognition (STT)
# Options: "local_browser", "vosk", "whisper_cpp"
STT_PROVIDER=local_browser
VOSK_MODEL_PATH=./models/vosk-model-small-en-in

# Text-to-Speech (TTS)
# Options: "web_speech", "edge_tts", "pyttsx3"
TTS_PROVIDER=web_speech

# Gmail Integration (Official Google OAuth 2.0 Credentials)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback

# WhatsApp Integration Mode
# Options: "android_intent" (free default), "cloud_api"
WHATSAPP_MODE=android_intent
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# AI Calling Integration Mode
# Options: "mock" (default safe simulator), "android_dialer", "twilio"
CALLING_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
